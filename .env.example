# ─── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=UTC

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_secret
POSTGRES_DB=buildora
# Used by backend (host "postgres" inside docker, "localhost" for local dev)
DATABASE_URL=postgresql://crm:crm_secret@localhost:5432/buildora?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Backend ───────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# JWT secrets — generate strong random values in production
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── File storage (S3-compatible) ──────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=buildora-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL=900

# ─── Email (SendGrid) ──────────────────────────────────────────────────────
SENDGRID_API_KEY=
MAIL_FROM=no-reply@buildora.example

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Business defaults ─────────────────────────────────────────────────────
DEFAULT_HOLD_HOURS=48
GST_RATE_UNDER_CONSTRUCTION=5
COMPANY_NAME=Buildora

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api
